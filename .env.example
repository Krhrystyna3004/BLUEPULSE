SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///bluepulse.db
FLASK_DEBUG=0
# Set to 1 only in a single scheduler-enabled web process (avoid duplicate jobs with multiple workers).
ENABLE_SCHEDULER=0
APP_TIMEZONE=Europe/Kyiv
# Comma-separated RSS feed URLs. Only add feeds whose terms/license permit this use.
RSS_FEEDS=
# Comma-separated exact hostnames allowed for RSS import, e.g. example.gov.ua
ALLOWED_FEED_HOSTS=
